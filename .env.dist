# Partybüchse – Vorlage für die lokale Konfiguration.
#
# Diese Datei ist die einzige Env-Vorlage im Repository und enthält nur
# Platzhalter, niemals echte Zugangsdaten. Zum Einrichten:
#
#   cp .env.dist .env       # und dort die Werte eintragen
#
# .env ist (wie .env.local) von Git ignoriert. Symfony lädt .env.dist
# automatisch als Fallback, solange keine .env existiert – die App startet
# also auch ohne Kopie, dann aber ohne Spotify- und Host-Zugangsdaten.
# Reihenfolge: .env.dist < .env < .env.local
#
# Die Werte für die Testumgebung stehen nicht hier, sondern in phpunit.dist.xml.

###> symfony/framework-bundle ###
APP_ENV=dev
# vor dem ersten Produktiv-Start durch einen langen Zufallsstring ersetzen
APP_SECRET=change-me-in-env-local-5f2b9c1e7a4d
# hinter einem Reverse Proxy z. B. 172.16.0.0/12 oder 127.0.0.1,REMOTE_ADDR
TRUSTED_PROXIES=
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# SQLite-Datei, wird von "composer setup" angelegt
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> symfony/debug-bundle ###
VAR_DUMPER_SERVER=127.0.0.1:9912
###< symfony/debug-bundle ###

###> app/host-login ###
# Login-Maske unter /login
HOST_USERNAME=
HOST_PASSWORD=
# Alternativ zu HOST_PASSWORD ein Hash – wegen der $-Zeichen in einfache
# Anführungszeichen setzen. Erzeugen mit: php bin/console security:hash-password
HOST_PASSWORD_HASH=
###< app/host-login ###

###> app/spotify ###
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/spotify/callback
###< app/spotify ###

###> app/public-url ###
# Adresse, die im QR-Code landet (leer = Host der aktuellen Anfrage)
PUBLIC_BASE_URL=
###< app/public-url ###
